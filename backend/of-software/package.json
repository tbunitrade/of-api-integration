{
  "name": "of-software",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && npm run postbuild",
    "postbuild": "npm run copy:extensions && npm run ensure:crondir && npm run ensure:cookies",
    "ensure:cookies": "mkdir -p \"$PWD/cookies\"",
    "ensure:dist-cookies": "mkdir -p \"$PWD/dist/cookies\"",
    "copy:extensions": "mkdir -p \"$PWD/dist/extensions/hcapt/0.4.1_0\" && cp -r \"$PWD/extensions/hcapt/0.4.1_0/\"* \"$PWD/dist/extensions/hcapt/0.4.1_0\"",
    "copy:cookies": "cp -r \"$PWD/cookies/\"* \"$PWD/dist/cookies/\" || true",
    "copy:extensions2": "mkdir -p dist/extensions/hcapt/0.4.1_0 && cp -r extensions/hcapt/0.4.1_0/* dist/extensions/hcapt/0.4.1_0",
    "ensure:crondir": "mkdir -p \"$PWD/dist/.cron-data\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "backend:start": "npm run build && DISPLAY=:10 pm2 stop backend; DISPLAY=:10 pm2 delete backend; DISPLAY=:10 pm2 start npm --name \"backend\" -- run start:prod && pm2 update && pm2 save",
    "start:serverold": "pm2 stop backend; pm2 delete backend; pm2 start npm --name \"backend\" -- start",
    "start:serverold2": "pm2 stop backend && pm2 delete backend && pm2 start npm --name \"backend\" -- start",
    "puppeteer:dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test-gui": "ts-node test-puppeteer.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d ./datasource.ts",
    "migration:run":       "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./datasource.ts",
    "migration:revert":    "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./datasource.ts"
  },
  "dependencies": {
    "@antiadmin/anticaptchaofficial": "^1.0.46",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/typeorm": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/lodash": "^4.17.0",
    "2captcha-ts": "^2.3.3",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "exceljs": "^4.4.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nopecha": "^1.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "puppeteer": "^24.26.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/cron": "^2.4.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
